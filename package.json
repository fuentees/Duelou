{
  "name": "duelou-app",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:8083": "expo start --web --port 8083",
    "typecheck": "tsc --noEmit",
    "api": "node --experimental-sqlite server/server.mjs",
    "test:api": "node --experimental-sqlite --test server/server.test.mjs server/rooms.test.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "test:arcade": "node scripts/check-arcade.mjs",
    "test:md3": "node scripts/check-md3.mjs",
    "build:web": "expo export --platform web --output-dir dist-web",
    "assets": "node scripts/build-assets.mjs",
    "db:backup": "node --experimental-sqlite scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "expo": "^57.0.21",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  }
}
