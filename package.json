{
  "name": "duelou-app",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:8083": "expo start --web --port 8083",
    "typecheck": "tsc --noEmit",
    "api": "node --experimental-sqlite server/server.mjs",
    "test:api": "node --experimental-sqlite --test server/server.test.mjs server/rooms.test.mjs server/skillGames.test.mjs server/competitive.test.mjs server/continuation.test.mjs server/rate-limit.test.mjs server/operations.test.mjs server/battle.test.mjs server/arena-challenges.test.mjs server/arena-match.test.mjs server/arena-persistence.test.mjs server/arena-queue.test.mjs",
    "test:ui": "node --experimental-sqlite scripts/check-unified-games.mjs",
    "test:character": "node scripts/check-character.mjs",
    "test:sync": "node scripts/check-campaign-sync.mjs",
    "test:account": "node --experimental-sqlite scripts/check-account-menu.mjs",
    "test:arcade": "node --experimental-sqlite scripts/check-unified-games.mjs",
    "test:resilience": "node scripts/check-competitive.mjs --resilience",
    "test:competitive": "node scripts/check-competitive.mjs",
    "test:md3": "node scripts/check-md3.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:container": "node scripts/check-container-files.mjs",
    "build:web": "expo export --platform web --output-dir dist-web",
    "assets:optimize": "node scripts/optimize-game-art.mjs",
    "assets": "node scripts/build-assets.mjs",
    "integrity:report": "node scripts/integrity-report.mjs",
    "metrics": "node scripts/product-metrics.mjs",
    "ops:check": "node scripts/check-health.mjs",
    "test:a11y": "node scripts/check-accessibility.mjs",
    "db:backup": "node --experimental-sqlite scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "expo": "^57.0.21",
    "expo-audio": "~57.0.5",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  }
}
